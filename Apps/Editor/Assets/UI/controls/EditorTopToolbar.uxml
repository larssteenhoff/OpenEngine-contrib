<UIElement>
  <UIElement class="top-toolbar-left">
    <UIElement class="toolbar-icons toolbar-icons-left">
      <Button id="TopToolbarLeft1" class="small secondary icon-button save-icon toolbar-outline-icon">
        <Label class="save-dirty-indicator hidden" text="*" />
      </Button>
      <Button id="TopToolbarLeft2" class="small secondary icon-button folder-open-icon toolbar-outline-icon" />
      <Button id="TopToolbarPackages" class="small secondary icon-button box-icon toolbar-outline-icon" />
      <Button id="TopToolbarLeft3" class="small secondary icon-button computer-icon toolbar-outline-icon" />
      <Button id="TopToolbarTodos" class="small secondary icon-button checkmark-icon toolbar-outline-icon" />
      <Button id="TopToolbarBookmarks" class="small secondary icon-button book-icon toolbar-outline-icon" />
      <Button id="TopToolbarBuild" class="small secondary icon-button game-controller-icon toolbar-outline-icon" />
      <Button id="TopToolbarSettings" class="small secondary icon-button settings-icon toolbar-outline-icon" />
      <Button id="TopToolbarHelp" class="small secondary icon-button top-toolbar-help-icon toolbar-outline-icon" />
      <Button id="TopToolbarUniversalSearch" class="small secondary icon-button top-toolbar-search-icon toolbar-outline-icon" />
    </UIElement>
  </UIElement>
  <UIElement class="top-toolbar-center">
    <UIElement class="toolbar-icons toolbar-icons-center">
      <Button id="TopToolbarCenter2" class="small secondary icon-button stop-icon" />
      <Button id="TopToolbarRecord" class="small secondary icon-button toolbar-record-icon" />
      <Button id="TopToolbarCenter3" class="small secondary icon-button pause-icon" />
      <Button id="TopToolbarCenter4" class="small secondary icon-button play-icon" />
    </UIElement>
  </UIElement>
  <UIElement class="top-toolbar-right">
    <UIElement class="toolbar-icons toolbar-icons-right">
      <Button id="TopToolbarCenter1" class="small secondary icon-button fullscreen-icon toolbar-outline-icon" />
      <Button id="TopToolbarUndoHistory" class="small secondary icon-button undo-icon toolbar-outline-icon" />
      <Button id="TopToolbarRight1" class="small secondary icon-button script-icon toolbar-outline-icon" />
      <Button id="TopToolbarNodeGraph" class="small secondary icon-button node-icon toolbar-outline-icon" />
      <Button id="TopToolbarTilePalette" class="small secondary icon-button tile-palette-icon" />
      <Button id="TopToolbarMixer" class="small secondary icon-button mixer-icon toolbar-outline-icon" />
      <Button id="TopToolbarAnimation" class="small secondary icon-button alarm-icon toolbar-outline-icon" />
      <Button id="TopToolbarTimeline" class="small secondary icon-button film-icon toolbar-outline-icon" />
      <Button id="TopToolbarVisualProfiler" class="small secondary icon-button pulse-icon toolbar-outline-icon" />
      <Button id="TopToolbarCpuProfiler" class="small secondary icon-button timer-icon toolbar-outline-icon" />
      <Button id="TopToolbarMonitors" class="small secondary icon-button stats-icon toolbar-outline-icon" />
      <Button id="TopToolbarVram" class="small secondary icon-button hardware-chip-icon toolbar-outline-icon" />
      <Button id="TopToolbarRenderGraph" class="small secondary icon-button pie-chart-icon toolbar-outline-icon" />
      <Button id="TopToolbarLog" class="small secondary icon-button alert-circle-icon toolbar-outline-icon" />
      <Button id="TopToolbarRight2" class="small secondary icon-button info-icon toolbar-outline-icon" />
      <Button id="TopToolbarPanelMenu" class="small secondary icon-button menulist-icon toolbar-outline-icon" />
    </UIElement>
